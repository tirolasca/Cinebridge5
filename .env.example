# Copie para .env para sobrescrever os valores padrão do docker-compose.yml
NODE_ENV=production

RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

PROFISSIONAIS_DB_USER=cinebridge
PROFISSIONAIS_DB_PASSWORD=cinebridge
PROJETOS_DB_USER=cinebridge
PROJETOS_DB_PASSWORD=cinebridge
RECOMENDACOES_DB_USER=cinebridge
RECOMENDACOES_DB_PASSWORD=cinebridge
NOTIFICACOES_DB_USER=cinebridge
NOTIFICACOES_DB_PASSWORD=cinebridge

# ---- ATVV: observabilidade e governança ----
LOG_LEVEL=info
GRAFANA_USER=admin
GRAFANA_PASSWORD=cinebridge          # TROQUE fora do ambiente de demonstração
HABILITAR_SIMULACAO=true             # habilita POST /admin/simulacao na API (desligue em produção)
FALHA_SIMULADA_PCT=3                 # % de falhas simuladas nos canais de notificação
TAXA_PLATAFORMA=0.1                  # taxa usada na "receita potencial"

# Limiares da governança (padrões do enunciado). Para demonstrar em poucos minutos, reduza as janelas:
# GOV_LATENCIA_JANELA_S=60   GOV_CPU_JANELA_S=60   GOV_CACHE_COOLDOWN_S=45   GOV_REVERSAO_S=180
GOV_LATENCIA_JANELA_S=300
GOV_CPU_JANELA_S=600
GOV_CACHE_COOLDOWN_S=120
GOV_REVERSAO_S=900
GOV_LIMITE_LOKI_MB=512
GOV_LIMITE_JAEGER_MB=256

# ---- Segurança (fase de modernização) ----
AMBIENTE=local                # "producao" ativa validações rígidas; em produção use docker-compose.prod.yml + .env.prod
ADMIN_TOKEN=                  # protege GET /config, POST /admin/simulacao (api) e GET /estado (governança). Vazio = liberado só em AMBIENTE=local
TRUST_PROXY=false
CORS_ORIGINS=                 # vazio = sem acesso cross-origin
RATE_LIMIT_MAX=120
DB_POOL_MAX=5
DOCKER_HABILITADO=true        # false = governança sem escalonamento/rotação por volume (hospedagem sem Docker Engine)

# ---- Control Center (http://localhost:3010/painel/) ----
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=         # vazio = senha aleatória impressa no log do cinebridge-admin ao iniciar (somente ambiente local)
COOKIE_SEGURO=false          # true quando servido por HTTPS
