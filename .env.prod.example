# Copie para .env.prod (NUNCA versionar) e preencha. Gere segredos com: sh scripts/gerar-segredos.sh
# Todas as variáveis abaixo são obrigatórias em produção (o compose recusa subir se faltar alguma).

DOMAIN=cinebridge.duckdns.org
ACME_EMAIL=voce@exemplo.com

ADMIN_TOKEN=                 # >= 24 caracteres (token interno entre serviços; não é a senha do painel)
ADMIN_USER=admin             # usuário do Control Center (/painel/)
ADMIN_PASSWORD_HASH=         # gere com: sh scripts/hash-senha.sh   (PowerShell: .\scripts\hash-senha.ps1)
RABBITMQ_USER=cinebridge
RABBITMQ_PASSWORD=
PROFISSIONAIS_DB_USER=cinebridge_prof
PROFISSIONAIS_DB_PASSWORD=
PROJETOS_DB_USER=cinebridge_proj
PROJETOS_DB_PASSWORD=
NOTIFICACOES_DB_USER=cinebridge_notif
NOTIFICACOES_DB_PASSWORD=
RECOMENDACOES_DB_USER=cinebridge_rec
RECOMENDACOES_DB_PASSWORD=

# Só com --profile observabilidade-completa
GRAFANA_USER=admin
GRAFANA_PASSWORD=

# Opcionais
CORS_ORIGINS=                # origens permitidas, separadas por vírgula (ex.: https://cinebridge.duckdns.org)
RATE_LIMIT_MAX=120           # requisições/min por IP na API
